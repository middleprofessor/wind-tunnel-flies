newdat[line == "AA2", x := 2 + offset]
newdat[line == "K45", x := 3]
newdat[line == "N60", x := 4]
gg <- ggplot(data = plot_data[sex == plot_sex],
aes(x = x,
y = wind_speed,
color = treatment)) +
# raw data
# geom_sina(maxwidth = 0.5,
#           color = "gray") +
geom_jitter(width = 0.05,
height = 0,
color = "gray") +
# line means
geom_point(data = newdat[sex == plot_sex],
aes(x = x,
y = fit),
size = 2) +
# treatment means and CI
geom_point(data = treatment_means[sex == plot_sex],
aes(x = x,
y = emmean),
size = 3) +
geom_errorbar(data = treatment_means[sex == plot_sex],
aes(x = x,
y = emmean,
ymin = lower.CL,
ymax = upper.CL),
width = 0) +
# clean plot
ylab("Max Burst Speed (cm/s)") +
scale_color_manual(values = pal_okabe_ito) +
scale_x_continuous(breaks = x_breaks,
labels = c("CN1", "CN2", "AA1", "AA2", "K45", "N60")) +
theme_pubr() +
theme(legend.position="none",
axis.title.x = element_blank()) +
coord_cartesian(ylim = c(0, 210),
xlim = c(0.7, 4.3)) +
ggtitle(title)
return(gg)
}

experiment = "Exp1",
exp1[, .SD, .SDcols = c("treatment", "line", "sex", "group",  "wind_speed")])
burst2 <- data.table(
experiment = "Exp2",
exp2[, .SD, .SDcols = c("treatment", "line", "sex", "group", "wind_jess")])
setnames(burst2, old = "wind_jess", new = "wind_speed")
burst <- rbind(burst1, burst2)
burst[, exp_line := paste(experiment, line, sep="\n")]
burst[, exp_line := factor(exp_line, levels = c(
"Exp1\nCN1", "Exp1\nCN2",
"Exp1\nAA1", "Exp1\nAA2",
"Exp2\nCN1", "Exp2\nCN2",
"Exp2\nAA1", "Exp2\nAA2",
"Exp2\nK45", "Exp2\nN60"
))]
combined_plot <- function(sex_in = "F", title = "Female"){
gg <- ggplot(data = burst[sex == sex_in],
aes(x = exp_line,
y = wind_speed,
color = group)) +
geom_jitter(width = 0.2,
height = 1,
size = .2) +
# clean plot
ylab("Max Opposing Wind Speed (cm/s)") +
scale_color_manual(values = pal_okabe_ito) +
theme_pubr() +
theme(legend.position="none",
axis.title.x = element_blank()) +
ggtitle(title)
return(gg)
}

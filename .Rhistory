#| label: fly-weights
#| echo: false
#| warning: false
#| eval: true
in_file <- "weights/AA-LIVE HYDRATED BODY WEIGHT DATA-1995-2016/weights 1995 (walker reformat).xlsx"
file_path <- here(data_folder, in_file)
d1995 <- read_excel(file_path,
range = "A1:K29") |>
data.table()
d1995[, fly_weight := vial_weight / n_flies * 1000]
read_weights <- function(file_path,
sheet_i,
range_i,
generation_i,
n_flies = 20,
del_col = NA){
dt_wide <- read_excel(file_path,
sheet = sheet_i,
range = range_i) |>
data.table()
if(!is.na(del_col)){
dt_wide[, c(del_col) := NULL]
}
colnames(dt_wide)[1] <- "set"
lines <- colnames(dt_wide)[-1]
dt_long <- melt(dt_wide,
id.vars = "set",
measure.vars = lines,
variable.name = "line_sex",
value.name = "vial_weight")
dt_long[, fly_weight := vial_weight/n_flies * 1000] # 20 flies per vial
dt_long[, c("line", "sex") := tstrsplit(line_sex, "-")]
dt_long[, treatment := substr(line, 1, 2)]
dt_long[treatment == "AA", treatment := "SEL"]
dt_long[, generation := generation_i]
return(dt_long)
}
in_file <- "weights/AA-LIVE HYDRATED BODY WEIGHT DATA-1995-2016/BODY WEIGHTS-2007.xlsx"
file_path <- here(data_folder, in_file)
d2007 <- read_weights(file_path,
sheet_i = "Sheet3",
range_i = "A1:i16",
generation_i = 465,
n_flies = 20)
in_file <- "weights/AA-LIVE HYDRATED BODY WEIGHT DATA-1995-2016/BODY WEIGHTS-2009-Kens 15 Sets.xlsx"
file_path <- here(data_folder, in_file)
d2009 <- read_weights(file_path,
sheet_i = "Sheet17",
range_i = "A1:m16",
generation_i = 520,
n_flies = 20)
in_file <- "weights/AA-LIVE HYDRATED BODY WEIGHT DATA-1995-2016/BODY WEIGHTS-2011-Sets for Emily-GEN560.xlsx"
file_path <- here(data_folder, in_file)
d2011 <- read_weights(file_path,
sheet_i = "Sheet1",
range_i = "A1:m20",
generation_i = 560,
n_flies = 25)
in_file <- "weights/AA-LIVE HYDRATED BODY WEIGHT DATA-1995-2016/BODY WEIGHTS-2013-August-GEN615-Graphs.xlsx"
file_path <- here(data_folder, in_file)
d2013 <- read_weights(file_path,
sheet_i = "Sheet2",
range_i = "A1:l8",
generation_i = 615,
n_flies = 20,
del_col = "MONTH-YEAR")
in_file <- "weights/LIVE HYDRATED BODY WEIGHTS 2016/body weights 2016 gen 692 walker reformat.xlsx"
file_path <- here(data_folder, in_file)
d2016 <- read_weights(file_path,
sheet_i = "Sheet1",
range_i = "A1:G9",
generation_i = 692,
n_flies = 20)
# combine
# exp1_weight = simons/walker weights from spring summer 2004, approximately gen 384 (but over several gens)
exp1_cols <- c("treatment", "line", "sex", "mass")
exp1_weight <- exp1[, .SD, .SDcols = exp1_cols]
setnames(exp1_weight, old = "mass", new = "fly_weight")
exp1_weight[, generation := 384]
exp1_weight[treatment == "AA", treatment := "SEL"]
keep_cols <- c("generation", "treatment", "line", "sex", "fly_weight")
weight <- rbind(d1995[, .SD, .SDcols = keep_cols],
d2007[, .SD, .SDcols = keep_cols],
d2009[, .SD, .SDcols = keep_cols],
d2011[, .SD, .SDcols = keep_cols],
d2013[, .SD, .SDcols = keep_cols],
d2016[, .SD, .SDcols = keep_cols],
exp1_weight[, .SD, .SDcols = keep_cols])
weight <- weight[line != "AL45"] #
weight[line %in% c("K4", "N6", "AL"), treatment := "WT"]
weight[, treatment := factor(treatment,
levels = c("SEL",
"CN", "WT"))]
gg_f <- ggplot(data = weight[sex == "F"],
aes(x = generation,
y = fly_weight,
color = treatment)) +
geom_point() +
ylab("Weight (mg)") +
xlab("Generation") +
ggtitle("Females") +
scale_color_manual(values = pal_okabe_ito) +
theme_pubr()
gg_m <- ggplot(data = weight[sex == "M"],
aes(x = generation,
y = fly_weight,
color = treatment)) +
geom_point() +
ylab("Weight (mg)") +
xlab("Generation") +
ggtitle("Males") +
scale_color_manual(values = pal_okabe_ito) +
theme_pubr()
plot_grid(gg_f, gg_m)
weight_means <- weight[, .(fly_weight = mean(fly_weight,
na.rm = TRUE)),
by = .(generation, sex, line, treatment)]
gg_f <- ggplot(data = weight_means[sex == "F"],
aes(x = generation,
y = fly_weight,
color = treatment)) +
geom_point() +
ylab("Weight (mg)") +
xlab("Generation") +
ggtitle("Females") +
scale_color_manual(values = pal_okabe_ito) +
theme_pubr()
gg_m <- ggplot(data = weight_means[sex == "M"],

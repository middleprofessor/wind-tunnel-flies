d2016 <- read_weights(file_path,
sheet_i = "Sheet1",
range_i = "A1:G9",
generation_i = 692,
n_flies = 20)
# combine
# exp1_weight = simons/walker weights from spring summer 2004, approximately gen 384 (but over several gens)
exp1_cols <- c("treatment", "line", "sex", "mass")
exp1_weight <- exp1[, .SD, .SDcols = exp1_cols]
setnames(exp1_weight, old = "mass", new = "fly_weight")
exp1_weight[, generation := 384]
exp1_weight[treatment == "AA", treatment := "SEL"]
keep_cols <- c("generation", "treatment", "line", "sex", "fly_weight")
weight <- rbind(d1995[, .SD, .SDcols = keep_cols],
d2007[, .SD, .SDcols = keep_cols],
d2009[, .SD, .SDcols = keep_cols],
d2011[, .SD, .SDcols = keep_cols],
d2013[, .SD, .SDcols = keep_cols],
d2016[, .SD, .SDcols = keep_cols],
exp1_weight[, .SD, .SDcols = keep_cols])
gg_f <- ggplot(data = weight[sex == "F"],
aes(x = generation,
y = fly_weight,
color = treatment)) +
geom_point() +
ylab("Weight (mg)") +
xlab("Generation") +
ggtitle("Females") +
theme_pubr()
gg_m <- ggplot(data = weight[sex == "M"],
aes(x = generation,
y = fly_weight,
color = treatment)) +
geom_point() +
ylab("Weight (mg)") +
xlab("Generation") +
ggtitle("Males") +
theme_pubr()

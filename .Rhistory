aes(x = line,
y = wind_speed)) +
geom_jitter(width = 0.1)
exp1_summary <- exp1[, .(wind_speed = mean(wind_speed)), by = .(treatment, sex, line)]
exp1_summary
lm_ancova <- lm(wind_speed ~ treatment * sex + room_temp, data = exp1)
coef(summary(lm_ancova))
ggplot(data = exp1,
aes(x = room_temp,
y = wind_speed,
color = treatment)) +
geom_point() +
#  geom_ancova(lm_ancova) +
NULL
exp1[, .(N = .N), by = .(line, sex)]
exp1_lmm <- lmer(wind_speed ~ treatment * sex + (1 | line), data = exp1)
coef(summary(exp1_lmm))
exp1_sigma <- summary(exp1_lmm)$sigma
exp1_emm <- emmeans(exp1_lmm, specs = c("treatment", "sex"))
cn_m <- c(1,0,0,0)
aa_m <- c(0,1,0,0)
cn_f <- c(0,0,1,0)
aa_f <- c(0,0,0,1)
exp1_contrast <- list(
list("F: AA - CN" = aa_f - cn_f),
list("M: AA - CN" = aa_m - cn_m)
)
exp1_pairs <- contrast(exp1_emm,
method = exp1_contrast,
adjust = "none") |>
summary(infer = TRUE) |>
data.table()
exp1_pairs[, effect_std := estimate / exp1_sigma]
# reorder for plot
exp1_pairs[, contrast := factor(contrast,
levels = c("M: AA - CN",
"F: AA - CN"))]
exp1_emm
exp1_pairs
# compute conditional means
newdat <- expand.grid(
line = levels(exp1$line),
sex = levels(exp1$sex)
) |>
data.table()
newdat[, treatment := ifelse(substr(newdat$line, 1, 2) == "AA", "AA", "CN")]
newdat[, fit := predict(exp1_lmm, newdata = newdat)]
# check with my own math

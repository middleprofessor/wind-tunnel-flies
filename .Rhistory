)
gg
#| label: lmm-model
#| echo: false
#| warning: false
#| eval: true
# lmm
wing_metric_plot <- function(y_col = "area",
sex_i = "F"){
r_form <- paste(y_col,
"~ treatment * temp_id * sex * exp_id +",
"(1 | line_id)") |>
as.formula()
area_lmm <- lmer(r_form, data = wing)
sigma <- summary(area_lmm)$sigma
# emm for statistics
area_emm_pairs <- emmeans(
area_lmm,
~ treatment | temp_id * sex
)
WT_means <- summary(area_emm_pairs)[summary(area_emm_pairs)$treatment == "WT", "emmean"]
area_pairs <- contrast(
area_emm_pairs,
method = "revpairwise"
) |>
summary(infer = TRUE) |>
data.table()
area_pairs[, d_perc := estimate / WT_means * 100]
area_pairs[, d_std := estimate / sigma]
area_pairs[, label := sprintf("\u0394 = %+.3f\n%+.1f%%\n%+.2f SD",
estimate, d_perc, d_std)]
area_pairs[, x := as.integer(temp_id)]
# plot treatment : temp : exp means
area_emm <- emmeans(
area_lmm,
~ treatment | temp_id * sex * exp_id
)
# compute exp_id : line means means
line_means <- wing[, .(fit = mean(get(y_col))),
by = .(treatment, temp_id, exp_id,
line_id, sex)]
# line_means <- expand.grid(
#   line_id = levels(wing$line_id),
#   sex = levels(wing$sex),
#   temp_id = levels(wing$temp_id),
#   exp_id = levels(wing$exp_id),
#   treatment = levels(wing$treatment)
# ) |>
#   data.table()
# line_means[, del := 0]
# line_means[line_id %in% c("A1", "A2") & treatment == "WT", del := 1]
# line_means[line_id %in% c("K4", "L4", "N6") & treatment == "SEL", del := 1]
# line_means <- newdat[del == 0,]
# line_means[, fit := predict(area_lmm, newdata = newdat)]
line_means[, x_temp_treat := as.integer(temp_id) +
(as.integer(treatment)-1.5)/2.5]
line_means[treatment == "WT", x_temp_line_treat := x_temp_treat +
(as.integer(line_id)-2)/10]
line_means[treatment == "SEL", x_temp_line_treat := x_temp_treat +
(as.integer(line_id)-4.5)/10]
# raw data to plot
plot_data <- wing[, .SD,
.SDcols = c("temp_id", "treatment", "exp_id",
"line_id","sex", y_col)]
plot_data[, x_temp_treat := as.integer(temp_id) +
(as.integer(treatment)-1.5)/2.5 +
rnorm(n=nrow(plot_data), mean = 0, sd = 0.01)]
plot_data[treatment == "WT", x_temp_line_treat := x_temp_treat +
(as.integer(line_id)-2)/10]
plot_data[treatment == "SEL", x_temp_line_treat := x_temp_treat +
(as.integer(line_id)-4.5)/10]
# plot_data[, .(x = mean(x)), by = .(temp_id, treatment)]
# emmeans to plot
plot_emm <- area_emm |>
summary() |>
data.table()
plot_emm[, x := as.integer(temp_id) +
(as.integer(treatment)-1.5)/20]
# y positions for annotation states
max_y <- max(plot_data[sex == sex_i, get(y_col)])
min_y <- min(plot_data[sex == sex_i, get(y_col)])
add_y <- (max_y - min_y) * .05
# plot it
gg <- ggplot(data = plot_data[sex == sex_i],
aes(x = x_temp_line_treat,
y = get(y_col),
color = treatment)) +
# show the data
geom_point() +
# line means
geom_point(data = line_means[sex == sex_i],
aes(x = x_temp_line_treat,
y = fit,
shape = exp_id),
size = 2,
color = "black") +
# treatment : temp means
geom_point(data = plot_emm[sex == sex_i],
aes(x = x,
y = emmean,
shape = exp_id),
size = 3,
color = "black") +
geom_point(data = plot_emm[sex == sex_i],
aes(x = x,
y = emmean,
color = treatment,
shape = exp_id),
size = 2) +
# geom_errorbar(data = plot_emm[sex == sex_i],
#               aes(x = x,
#                   y = emmean,
#                   ymin = lower.CL,
#                   ymax = upper.CL,
#                   color = treatment)) +
# annotation stats
geom_text(
data = area_pairs[sex == sex_i,],
aes(x = x, y = max_y + 3*add_y, label = label),
inherit.aes = FALSE
) +
scale_color_manual(values = pal_okabe_ito) +
scale_x_continuous(breaks = 1:3,
labels = c("23°", "26°", "29°")) +
coord_cartesian(xlim = c(0.5, 3.5),
ylim = c(min_y - add_y, max_y + 4*add_y)) +
theme_pubr() +
theme(legend.position="none",
axis.title.x = element_blank()) +
NULL
return(gg)
}
gg_area_f <- wing_metric_plot(y_col = "area", sex_i = "F") +
ylab(expression(paste("Wing Area (", mm^2, ")")))
gg_area_m <- wing_metric_plot(y_col = "area", sex_i = "M") +
ylab(expression(paste("Wing Area (", mm^2, ")")))
gg_WL_f <- wing_metric_plot(y_col = "wing_length", sex_i = "F") + ylab("Wing Length (mm)")
gg_WL_m <- wing_metric_plot(y_col = "wing_length", sex_i = "M") + ylab("Wing Length (mm)")
gg_WC_f <- wing_metric_plot(y_col = "mean_chord", sex_i = "F") + ylab("Mean Chord (mm)")
gg_WC_m <- wing_metric_plot(y_col = "mean_chord", sex_i = "M") + ylab("Mean Chord (mm)")
gg_AR_f <- wing_metric_plot(y_col = "aspect_ratio", sex_i = "F") +
ylab("Aspect Ratio")
gg_AR_m <- wing_metric_plot(y_col = "aspect_ratio", sex_i = "M") +
ylab("Aspect Ratio")
gg_r_f <- wing_metric_plot(y_col = "xbar_hat", sex_i = "F") +
ylab(expression(bar(x)/R))
gg_r_m <- wing_metric_plot(y_col = "xbar_hat", sex_i = "M") +
ylab(expression(bar(x)/R))
gg_r2_f <- wing_metric_plot(y_col = "r2_hat_sq", sex_i = "F") +
ylab(expression(hat(r)[2]^2))
gg_r2_m <- wing_metric_plot(y_col = "r2_hat_sq", sex_i = "M") +
ylab(expression(hat(r)[2]^2))
gg_f <- plot_grid(gg_area_f,gg_WL_f,gg_WC_f,gg_AR_f,gg_r_f,gg_r2_f,
nrow = 3)
ggsave(
"wing_metrics_f.png",
gg_f,
width = 8,
height = 12,
dpi = 300
)
gg_f
gg_m <- plot_grid(gg_area_m,gg_WL_m,gg_WC_m,gg_AR_m,gg_r_m,gg_r2_m,
nrow = 3)
ggsave(
"wing_metrics_m.png",
gg_m,
width = 8,
height = 12,
dpi = 300
)
gg_m
gg_area_f
gg_area_m
gg_WL_f

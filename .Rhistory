)
wing_measures[j, ] <- combined_j
}
# delete empty rows
# wing_measures <- na.omit(wing_measures)
# fig_mat <- na.omit(fig_mat)
files_short   <- files_short[valid]
fig_mat       <- fig_mat[valid, , drop = FALSE]
wing_measures <- wing_measures[valid, , drop = FALSE]
# save landmarks
wing_lm <- rbind(
wing_lm,
data.table(
file = str_remove(files_short, "\\.txt$"),
temp_id = str_sub(files_short, 2, 2),
line_id = str_sub(files_short, 3, 4),
sex = str_sub(files_short, 5, 5),
exp_id = str_sub(files_short, 6, 6),
fly_id = str_extract(files_short, "(?<=^.{6})\\d{1,2}"),
fig_mat
)
)
# save wing metrics
wing <- rbind(
wing,
data.table(
file = str_remove(files_short, "\\.txt$"),
temp_id = str_sub(files_short, 2, 2),
line_id = str_sub(files_short, 3, 4),
sex = str_sub(files_short, 5, 5),
exp_id = str_sub(files_short, 6, 6),
fly_id = str_extract(files_short, "(?<=^.{6})\\d{1,2}"),
wing_measures
)
)
}
wing[, treatment := ifelse(line_id == "A1" |
line_id == "A2",
"SEL", "WT") |>
factor(levels = c("WT", "SEL"))]
wing[, temp_id := factor(temp_id)]
wing[, line_id := factor(line_id,
levels = c("K4","L4","N6","A1","A2"))]
wing_lm[, treatment := ifelse(line_id == "A1" |
line_id == "A2",
"SEL", "WT") |>
factor(levels = c("WT", "SEL"))]
levels(wing$line_id)
#| label: lmm-model
#| echo: false
#| warning: false
#| eval: true
area_lmm <- lmer(area ~ treatment * temp_id * sex * exp_id +
(1 | line_id),
data = wing)
area_emm <- emmeans(area_lmm, specs =
c("sex", "treatment", "temp_id"))
area_emm <- emmeans(
area_lmm,
~ treatment | temp_id * sex
)
area_pairs <- contrast(
area_emm,
method = "revpairwise"
) |>
summary(infer = TRUE) |>
data.table()
plot_data <- wing[, .SD,
.SDcols = c("temp_id", "treatment", "exp_id",
"line_id","sex", "area")]
plot_data[, x_temp_treat := as.integer(temp_id) +
(as.integer(treatment)-1.5)/5 +
rnorm(n=nrow(plot_data), mean = 0, sd = 0.01)]
plot_data[, x_temp_line_treat := as.integer(temp_id) +
(as.integer(treatment)-1.5)/5 +
rnorm(n=nrow(plot_data), mean = 0, sd = 0.01)]
# plot_data[, .(x = mean(x)), by = .(temp_id, treatment)]
gg <- ggplot(data = plot_data[sex == "F"],
aes(x = x_temp_treat,
y = area,
color = treatment)) +
geom_point() +
# geom_jitter(
#   position = position_jitterdodge(
#     jitter.width = 0.15,
#     dodge.width = 0.6
#   ),
#   alpha = 0.5
# ) +
scale_color_manual(values = pal_okabe_ito) +
scale_x_continuous(breaks = 1:3,
labels = c("23°", "26°", "29°")) +
ylab("Wing Area (mm^2)") +
coord_cartesian(xlim = c(0.5, 3.5)) +
theme_pubr() +
theme(#legend.position="none",
axis.title.x = element_blank()) +
NULL
gg

# import and wrangling
library(readxl)
library(data.table)
library(here)
library(janitor) # clean_names
# analysis
library(emmeans)
# tables and figures
library(ggplot2)
library(ggpubr)
library(knitr)
library(kableExtra)
source_path <- here("R/ggplot_the_model.R")
source(source_path)
here <- here::here
clean_names <- janitor::clean_names
data_folder <- "data"
# create directory path
file_folder <- "Coupling of bone resorption and formation by RANKL reverse signalling"
file_in <- "Ikebuchi-2018-RANKL_fig4e.xlsx"
file_path <- here(data_folder, file_folder, file_in)
# the range argument isn't necessary since the excel sheet is tidy
# the col_names argument isn't necessary since TRUE is the default
fig4e <- read_excel(file_path,
sheet = "fig4e",
range = "A1:B17", # not necessary
col_names = TRUE) |> # not necessary
data.table()
# relevel treatment levels
treatment_levels <- c("WT", "RANKL_p29A")
fig4e[, treatment := factor(treatment,
levels = treatment_levels)]
# View(fig4e)
# Fit Model
m1 <- lm(mar ~ treatment, data = fig4e)
# Coefficients
m1_coef <- cbind(
coef(summary(m1)),
confint(m1)
)
# Modeled Means
m1_emm <- emmeans(m1, specs = "treatment")
# Contrasts
m1_pairs <- contrast(m1_emm,
method = "revpairwise") |>
summary(infer = TRUE)
m1_coef |>
kable(digits = c(2,3,1,8,2,2),
caption = "Coefficients of the model m1 fit to the data from experiment 4e.") |>
kable_styling()
m1_emm |>
summary() |>
kable(digits = c(1,2,3,1,2,2),
caption = "Modeled means of fig4e.") |>
kable_styling()
m1_pairs |>
kable(digits = c(1,2,3,1,2,2,1,5),
caption = "Estimated effect of RANKL mutation on mineral apposition rate (mar).") |>
kable_styling()
ggplot_the_response(m1,
m1_emm,
m1_pairs,
y_label = "MAR (µm per day)")
# create directory path
file_folder <- "Disruption of the beclin 1–BCL2 autophagy regulatory complex promotes longevity in mice"
file_in <- "Fernandez-beclin.xlsx"
file_path <- here(data_folder, file_folder, file_in)
# the range argument isn't necessary since the excel sheet is tidy
# the col_names argument isn't necessary since TRUE is the default
fig3b <- read_excel(file_path,
sheet = "Fernandez-beclin",
range = "A1:E47", # not necessary
col_names = TRUE) |> # not necessary
data.table()
# relevel treatment levels
genotype_levels <- c("wt", "ki")
fig3b[, genetype := factor(genotype,
levels = genotype_levels)]
# View(fig3b)
m1 <- lm(positive_nuclei_per_area ~ genotype,
data = fig3b)
m1_emm <- emmeans(m1, specs = "genotype")
m1_pairs <- contrast(m1_emm,
method = "revpairwise") |>
summary(infer = TRUE)
m1_pairs
ggplot_the_response(m1, m1_emm, m1_pairs,
y_label = "Positive nuclei per area")
# create directory path
file_folder <- "BCAA catabolism in brown fat controls energy homeostasis through SLC25A44"
file_in <- "yoneshiro_2019_bcaa.xlsx"
file_path <- here(data_folder, file_folder, file_in)
# the range argument isn't necessary since the excel sheet is tidy
# the col_names argument isn't necessary since TRUE is the default
fig2g <- read_excel(file_path,
sheet = "fig. 2g",
range = "A6:H34", # not necessary
col_names = TRUE) |> # not necessary
data.table()
# relevel treatment levels
treatment_levels <- c("KO", "WT")
fig2g[, treatment := factor(treatment, levels = treatment_levels)]
# View(fig3b)
fig2g_long <- melt(fig2g,
id.vars = c("treatment", "mouse_id"),
measure.vars = c("glucose0", "glucose15", "glucose30",
"glucose60", "glucose90", "glucose120"),
variable.name = "period",
value.name = "glucose")
# extract time from period name
fig2g_long[, time := substr(period, 8, nchar(as.character(period)))]
# convert time to numeric
fig2g_long[, time := as.numeric(time)]
# dodge time
fig2g_long[, time_dodge := ifelse(treatment == "WT",
time - 1,
time + 1)]
gg <- ggplot(data = fig2g_long,
aes(x = time_dodge,
y = glucose,
color = treatment,
group = mouse_id)) +
geom_point() +
geom_line() +
scale_x_continuous(
breaks = c(0, 15, 30, 60, 90, 120),
labels = c("0", "15", "30", "60", "90", "120")) +
xlab("Time") +
scale_color_manual(values = pal_okabe_ito_2) +
theme_pubr()
gg
# create directory path
file_folder <- "A big-data approach to understanding metabolic rate and response to obesity in laboratory mice"
file_in <- "mmpc_all_phases.csv"
file_path <- here(data_folder, file_folder, file_in)
clean_names <- janitor::clean_names
# the range argument isn't necessary since the excel sheet is tidy
# the col_names argument isn't necessary since TRUE is the default
fig1 <- fread(file_path) |>
clean_names()
data.table()
# relevel diet levels
diet_levels <- c("LF", "HF")
fig1[, diet := factor(diet,
levels = diet_levels)]
# View(fig3b)
ggscatter(data = fig1,
x = "subject_mass",
y = "vo2")
ggscatter(data = fig1[vo2 > 25,],
x = "subject_mass",
y = "vo2")
wbf_norm <- c(315,310,314,315)
mass <- c(1.18, 1.23,1.24,1.21)
wbf <- wfb_norm * mass^(1/3)
wbf <- wbf_norm * mass^(1/3)
wbf
mass^(1/3) * mass^3
mass
wbf <- wbf_norm / mass^(1/3)
wbf
# wrangling packages
library(data.table) # magical data frames
library(here) # here makes a project transportable
library(janitor) # clean_names
library(readxl) # read_excel, duh!
library(writexl) # write_xlsx, duh!
library(stringr) # text wrangling
# analysis packages
library(lme4)
library(lmerTest)
library(emmeans) # the workhorse for inference
library(sf)
# graphing packages
library(ggsci) # color palettes
library(ggpubr) # publication quality plots
library(ggforce) # better jitter
library(cowplot) # combine plots
library(knitr) # kable tables
library(kableExtra) # kable_styling tables
library(jpeg)
# ggplot_the_model.R packages not loaded above
library(insight)
library(afex) # aov4
# use here from the here package
here <- here::here
# use clean_names from the janitor package
clean_names <- janitor::clean_names
# use transpose from data.table
transpose <- data.table::transpose
# load functions used by this text written by me
# ggplot_the_model.R needs to be in the folder "R"
# if you didn't download this and add to your R folder in your
# project, then this line will cause an error
source(here("code", "ggplot_the_model.R"))
here("code", "ggplot_the_model.R")
